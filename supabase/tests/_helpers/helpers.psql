-- テスト用の共通道具。各テストの begin の直後に `\ir _helpers/helpers.psql` で読み込む。
-- pg_temp に作るので、テストの接続が終われば消える（DB には何も残らない）。
-- テストデータは seed とは別に、ここで毎回作る（seed の中身が変わってもテストが揺れないように）。

-- 利用者を作る。auth.users に入れると、トリガー（handle_new_user）が
-- profiles と profiles_private を自動で作る。メールは大学ドメインでないと弾かれる。
create or replace function pg_temp.make_user(
  p_id uuid, p_email text, p_name text, p_enrolled boolean default true
) returns uuid language plpgsql as $$
begin
  insert into auth.users (
    instance_id, id, aud, role, email, encrypted_password,
    email_confirmed_at, created_at, updated_at,
    raw_app_meta_data, raw_user_meta_data,
    confirmation_token, recovery_token, email_change, email_change_token_new
  ) values (
    '00000000-0000-0000-0000-000000000000', p_id, 'authenticated', 'authenticated', p_email, '',
    now(), now(), now(),
    '{"provider":"email","providers":["email"]}',
    jsonb_build_object('name', p_name, 'university', '中央大学', 'faculty', '経済学部', 'grade', '2年'),
    '', '', '', ''
  );
  -- 在籍中なら1年後まで有効、在籍切れなら期限なし（null＝失効扱い）
  update public.profiles
     set enrollment_valid_until = case when p_enrolled then now() + interval '1 year' end
   where id = p_id;
  return p_id;
end $$;

-- 出品を作る
create or replace function pg_temp.make_listing(p_id uuid, p_seller uuid, p_price int default 1000)
returns uuid language sql as $$
  insert into public.listings (id, title, subject, condition, price, location, seller_id)
  values (p_id, 'テスト用の教科書', 'テスト', '書き込みなし', p_price, '正門前', p_seller)
  returning id;
$$;

-- 予約を作る（価格と出品者は出品から取る。トリガーが突き合わせるため）
create or replace function pg_temp.make_reservation(p_id uuid, p_listing uuid, p_buyer uuid)
returns uuid language sql as $$
  insert into public.reservations
    (id, listing_id, buyer_id, seller_id, price, preferred_date, preferred_time, preferred_location)
  select p_id, l.id, p_buyer, l.seller_id, l.price, '2026-10-01', '昼休み', '正門前'
    from public.listings l where l.id = p_listing
  returning id;
$$;

-- ここから下は「誰としてふるまうか」の切り替え。
-- アプリからの接続と同じく、ロールと JWT の中身（auth.uid() の元）を差し替える。

-- ログイン済みの利用者として
create or replace function pg_temp.as_user(p_uid uuid) returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_uid, 'role', 'authenticated')::text, true);
  execute 'set local role authenticated';
end $$;

-- ログインしていない人として
create or replace function pg_temp.as_anon() returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  execute 'set local role anon';
end $$;

-- テストの準備側（管理者）に戻る
create or replace function pg_temp.as_admin() returns void language plpgsql as $$
begin
  execute 'reset role';
  perform set_config('request.jwt.claims', '', true);
end $$;

-- 件数を数える。読み取りがエラーになったら -1 を返す。
-- 直接 select count(*) を is() に渡すと、権限エラーでテストファイル全体が止まり、
-- どのテストが落ちたのか分からなくなるため。
create or replace function pg_temp.try_count(p_sql text) returns int language plpgsql as $$
declare n int;
begin
  execute 'select count(*) from (' || p_sql || ') t' into n;
  return n;
exception when others then
  return -1;
end $$;

-- 運営フラグを立てる。画面からは立てられない列なので、準備側（superuser）で直接書く。
create or replace function pg_temp.make_admin(p_id uuid) returns void language sql as $$
  update public.profiles set is_admin = true where id = p_id;
$$;
