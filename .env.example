# このファイルはGitにコミットする「見本」です（実際の値は入れない）。
# 各自 .env.local にコピーして値を埋めてください。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# PAY.jp（決済）。公開鍵はクライアント露出OK、秘密鍵はサーバー専用（NEXT_PUBLIC_厳禁）。
NEXT_PUBLIC_PAYJP_PUBLIC_KEY=
# PAYJP_SECRET_KEY=
# 3Dセキュア必須化。既定は必須（未認証トークンでのカード登録を拒否）。開発時のみ false で無効化可。
# PAYJP_3DS_REQUIRED=true
# Webhook 検証トークン。PAY.jp ダッシュボード→Webhook で設定した X-Payjp-Webhook-Token と一致させる。
# PAYJP_WEBHOOK_TOKEN=

# 決済会社の切り替え（lib/payment-provider/config.ts）。未設定は stripe と同じ。
#   stripe = Stripe Connect（既定）
#   payjp  = PAY.jp（現在は使わない方針。退路として実装は残してある）
# サーバーとクライアントが必ず同じ決済会社を見るよう、意図的に1変数にしている。
# NEXT_PUBLIC_* はビルド時にインライン化されるため、切り替えには再デプロイが要る。
# NEXT_PUBLIC_PAYMENT_PROVIDER=stripe

# Stripe（決済）。公開鍵はクライアント露出OK、秘密鍵はサーバー専用（NEXT_PUBLIC_厳禁）。
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# Webhook 署名シークレット。`stripe listen` の出力、または Stripe ダッシュボード→Webhook から取得。
# PAY.jp と違い固定トークンではなく、生ボディに対する HMAC 署名の検証に使う。
# STRIPE_WEBHOOK_SECRET=
# 3Dセキュアの「こちら側の検査」を無効化する開発用スイッチ。既定は必須。
# ※ 日本のクレジットカード・セキュリティガイドラインに該当する取引では、この値に関係なく
#   Stripe 側が自動的に 3DS を要求する。これはあくまで自前の検査の可否のみを制御する。
# STRIPE_3DS_REQUIRED=true

# Resend（メール送信）。再認証(reverify)メールの HTTP API 送信に使用（app/api/reverify/request）。
# Supabase Auth の登録確認メールは別途ダッシュボードの SMTP 設定で Resend を指定する（docs/resend-email-setup.md 参照）。
# 未設定時は reverify メールは送信されず、サーバーログに確認リンクを出す開発フォールバックになる。
# RESEND_API_KEY=
# REVERIFY_MAIL_FROM=TETOMI <no-reply@tetomi.jp>

# メール確認リンク・認証リダイレクトのベースURL。本番は必ず設定する（未設定だと
# localhost 登録時に確認リンクが localhost を指す）。Supabase ダッシュボードの Site URL とも一致させること。
# NEXT_PUBLIC_SITE_URL=https://tetomi.jp

# プレリリース段階解禁のフェーズ（lib/prerelease.ts）。未設定は 0 と同じ。
#   0=閲覧のみ / 1=購入・予約解禁 / 2=出品解禁 / 3+=全解禁
# 解禁時はこの値を上げて再デプロイするだけ（コード変更不要）。
# NEXT_PUBLIC_RELEASE_PHASE=0
